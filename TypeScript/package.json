    "chai": "^5.3.3",
    "jest": "^30.1.1",
    "mocha": "^10.8.2",
    "nyc": "^17.1.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
